# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (use Supabase pooler on port 6543 with ?pgbouncer=true for serverless)
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"

# Resend
RESEND_API_KEY=re_your_api_key
RESEND_FROM="Stays In Marrakech <onboarding@resend.dev>"
ADMIN_EMAIL=contact@yourdomain.com

# CSRF
CSRF_SECRET=generate-with-openssl-rand-hex-32

# Cron (protects /api/cron — required or the endpoint stays locked)
CRON_SECRET=your-cron-secret

# Upstash Redis (optional — enables shared rate limiting; falls back to in-memory per instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Site (set to your production URL)
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
